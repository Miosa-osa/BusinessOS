# BusinessOS Production Configuration
# This is a TEMPLATE with placeholder values.
# Copy to .env and fill in real values before use.
# NEVER commit a file with real secrets to version control.

# =============================================================================
# Database (Supabase)
# Connection pooler URL from: Supabase project > Settings > Database > Connection string
# Use the pooler (port 6543) for serverless/Cloud Run; direct (port 5432) for migrations.
# =============================================================================
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# =============================================================================
# Security Keys
# Generate with: openssl rand -base64 64 | tr -d '\n'
# =============================================================================
SECRET_KEY=GENERATE_64_BYTE_RANDOM_KEY_HERE
TOKEN_ENCRYPTION_KEY=GENERATE_32_BYTE_RANDOM_KEY_HERE
REDIS_KEY_HMAC_SECRET=GENERATE_32_BYTE_RANDOM_KEY_HERE

# =============================================================================
# Redis (Upstash)
# From: Upstash Console > Redis > REST API & SDK > Node.js / Go
# =============================================================================
REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379
REDIS_PASSWORD=[PASSWORD]
REDIS_TLS_ENABLED=true

# =============================================================================
# Server
# =============================================================================
SERVER_PORT=8080
ENVIRONMENT=production
DEPLOYMENT_MODE=cloud
# All origins that are allowed to call this API (comma-separated)
ALLOWED_ORIGINS=https://app.businessos.dev,https://businessos.dev

# =============================================================================
# AI
# =============================================================================
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
DEFAULT_MODEL=claude-sonnet-4-20250514
ENABLE_LOCAL_MODELS=false

# =============================================================================
# Google OAuth
# From: https://console.cloud.google.com > APIs & Services > Credentials
# Redirect URI must be registered in the OAuth client.
# =============================================================================
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-REPLACE_ME
GOOGLE_REDIRECT_URI=https://api.businessos.dev/api/v1/auth/oauth/google/callback

# =============================================================================
# MIOSA (internal platform service key)
# =============================================================================
MIOSA_API_URL=https://api.miosa.ai
MIOSA_API_KEY=PLATFORM_SERVICE_KEY_HERE

# =============================================================================
# Stripe
# Use sk_live_* in production. Never use sk_test_* in production.
# Webhook secret from: Stripe Dashboard > Webhooks > your endpoint > Signing secret
# =============================================================================
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_PRO=price_REPLACE_ME
STRIPE_PRICE_GROWTH=price_REPLACE_ME
STRIPE_PRICE_BUSINESS=price_REPLACE_ME

# =============================================================================
# OptimalOS Engine
# Disabled in cloud — runs inside Computer VMs, not in the API process.
# =============================================================================
OPTIMAL_ENABLED=false
CARRIER_ENABLED=false
NATS_ENABLED=false
