DATABASE_URL=postgres://localhost:5432/business_os?sslmode=disable
SECRET_KEY=generate-a-random-64-byte-key-here
TOKEN_ENCRYPTION_KEY=generate-a-random-32-byte-key-here
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_KEY_HMAC_SECRET=generate-a-random-32-byte-key-here
REDIS_TLS_ENABLED=false
SERVER_PORT=8001
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,app://localhost
AI_PROVIDER=ollama_local
OLLAMA_LOCAL_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2:3b
OSA_MODE=local
ENABLE_LOCAL_MODELS=true
# OptimalEngine runtime — Elixir engine (canonical) or Go port (fallback).
#
# Production / canonical path:
#   1. Start the Elixir engine in a separate terminal:
#        cd optimal-engine
#        OPTIMAL_NODES_ROOT=$(pwd)/sample-workspace/nodes \
#        OPTIMAL_API_ENABLED=true \
#        mix run --no-halt
#      (or: make optimal-engine)
#   2. Set OPTIMAL_ENGINE_URL below — BusinessOS will reverse-proxy every
#      /api/optimal/* request to the running Elixir engine.
#
# Fallback (no Elixir installed): leave OPTIMAL_ENGINE_URL blank.
# BusinessOS uses the in-process Go port. Less feature-complete but
# zero-dependency.
OPTIMAL_ENGINE_URL=http://localhost:4200

# Workspace paths used by the in-process Go port AND by the Elixir engine
# when launched via `mix run`. Default: bundled sample-workspace.
OPTIMAL_OS_ROOT=../../optimal-engine/sample-workspace
OPTIMAL_NODES_ROOT=../../optimal-engine/sample-workspace/nodes
OPTIMAL_ENGINE_PATH=../../optimal-engine
OPTIMAL_DB_PATH=../../optimal-engine/sample-workspace/.system/index.db
CARRIER_ENABLED=false
NATS_ENABLED=false
OSA_WEBHOOK_SECRET=change-this-in-production

# Cloud connection (optional — set these to connect to BusinessOS Cloud)
MIOSA_API_URL=
MIOSA_API_KEY=
