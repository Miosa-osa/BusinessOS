desktop/backend-go/internal/handlers/stripe_webhook.go

# Superadmin seed migration (contains admin email list)
desktop/backend-go/internal/database/migrations/104_seed_superadmin.sql

# Admin panel UI
frontend/src/routes/(app)/admin/

# Sync workflow + exclude manifest (no need to publish the mechanism)
.github/workflows/sync-oss.yml
.oss-exclude
.oss-stubs/
